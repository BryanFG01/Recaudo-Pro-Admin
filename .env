BACK_URL=https://recaudo-pro-back-production.up.railway.app/

# URL del backend para el frontend (Vite requiere prefijo VITE_)
VITE_BACK_URL=https://recaudo-pro-back-production.up.railway.app

# Supabase (solo si usas Recaudos, Créditos o Dashboard desde Supabase)
# Si no los defines, la app arranca; al entrar a esas secciones verás un error.
# VITE_SUPABASE_URL=https://xxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Para scripts/create-super-user-supabase.mjs (crear usuario super en Supabase):
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   ← Project Settings → API → service_role (secret)
# CREATE_SUPER_PASSWORD=TuClaveSegura
# CREATE_SUPER_EMAIL=super-arg01@recaudopro.admin
# BUSINESS_CODE=ARG01

