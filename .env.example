# Copia este archivo a .env y rellena los valores.
# cp .env.example .env

# Backend API (requerido: Auth, Clientes, Dashboard, Créditos, Recaudos)
VITE_BACK_URL=https://tu-backend.up.railway.app

# Opcional: alias de VITE_BACK_URL
# VITE_API_BASE_URL=https://tu-backend.up.railway.app

# Subida de imágenes: "supabase" = directo a Storage (requiere VITE_SUPABASE_*); o ruta ej. /api/upload/image
# VITE_UPLOAD_IMAGE_ENDPOINT=supabase
# VITE_UPLOAD_IMAGE_ENDPOINT=/api/upload/image

# Supabase (para VITE_UPLOAD_IMAGE_ENDPOINT=supabase). anon key: Project settings → API
# VITE_SUPABASE_URL=https://xxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
